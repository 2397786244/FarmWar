[gd_scene load_steps=7 format=3]

[ext_resource type="Script" path="res://src/vehicle_shield_bubble.gd" id="1_script"]

[sub_resource type="StandardMaterial3D" id="Material_shield"]
transparency = 1
shading_mode = 0
albedo_color = Color(0.86, 0.94, 1, 0.16)
emission_enabled = true
emission = Color(0.8, 0.92, 1, 1)
emission_energy_multiplier = 2.4
roughness = 0.25

[sub_resource type="Shader" id="Shader_golden_edge"]
code = "shader_type spatial;
render_mode unshaded, blend_add, cull_back, depth_draw_never;

uniform vec4 edge_color : source_color = vec4(1.0, 0.58, 0.08, 1.0);
uniform float edge_energy = 4.0;
uniform float edge_opacity = 0.72;
uniform float edge_power = 3.2;

void fragment() {
	float view_facing = abs(dot(normalize(NORMAL), normalize(VIEW)));
	float rim = pow(clamp(1.0 - view_facing, 0.0, 1.0), edge_power);
	ALBEDO = edge_color.rgb;
	EMISSION = edge_color.rgb * edge_energy * rim;
	ALPHA = rim * edge_opacity;
}"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_golden_edge"]
render_priority = 1
shader = SubResource("Shader_golden_edge")

[sub_resource type="SphereMesh" id="Sphere_shield"]
material = SubResource("Material_shield")
radius = 1.0
height = 2.0
radial_segments = 32
rings = 16

[sub_resource type="SphereShape3D" id="SphereShape_shield_hit"]
radius = 1.0

[node name="VehicleShieldBubble" type="Node3D"]
script = ExtResource("1_script")

[node name="ShieldMesh" type="MeshInstance3D" parent="."]
cast_shadow = 0
mesh = SubResource("Sphere_shield")

[node name="GoldenEdgeGlow" type="MeshInstance3D" parent="."]
cast_shadow = 0
